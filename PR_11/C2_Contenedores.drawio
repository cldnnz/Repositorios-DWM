<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="C2_Contenedores" name="C2_Contenedores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1230" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="C2 · Contenedores de Nikkei Roll · Nikkei Roll" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470.0" y="0" width="900" height="36" as="geometry"/></mxCell><mxCell id="bound0" value="Nikkei Roll" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BCC8D4;dashed=0;verticalAlign=top;align=center;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1780" height="980" as="geometry"/></mxCell><mxCell id="web" value='&lt;b style="font-size:13px"&gt;Frontend web&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: HTML / CSS / JavaScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;HTML, Tailwind CSS y JavaScript. Se sirve con http.server en el puerto 3000&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="270" height="120" as="geometry"/></mxCell><mxCell id="auth" value='&lt;b style="font-size:13px"&gt;Servicio de autenticación&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 9000. Usuarios semilla con PBKDF2, tokens Bearer opacos de 15 minutos e introspección&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="270" height="120" as="geometry"/></mxCell><mxCell id="gateway" value='&lt;b style="font-size:13px"&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 8000. Única entrada del navegador. Valida token, aplica roles y reenvía&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="270" height="120" as="geometry"/></mxCell><mxCell id="graphql" value='&lt;b style="font-size:13px"&gt;Agregador GraphQL&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Node.js / Apollo Server]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Node.js 4000. Apollo Server y Mongoose. Consultas y mutaciones de productos&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="320" width="270" height="120" as="geometry"/></mxCell><mxCell id="mongo" value='&lt;b style="font-size:13px"&gt;nikkei_roll_db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: MongoDB]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Base MongoDB local 27017 con la colección de productos&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="320" width="270" height="120" as="geometry"/></mxCell><mxCell id="core" value='&lt;b style="font-size:13px"&gt;Servicios de dominio&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 9001. Inventario, clientes, pedidos y pagos. Solo acepta tráfico con X-Gateway-Secret&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="570" width="270" height="120" as="geometry"/></mxCell><mxCell id="broker" value='&lt;b style="font-size:13px"&gt;ActiveMQ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: ActiveMQ]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Broker STOMP 1.2 en el puerto 61613. Cola persistente /queue/pedidos_nikkei&lt;/span&gt;' style="shape=cylinder3;direction=south;boundedLbl=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="570" width="270" height="120" as="geometry"/></mxCell><mxCell id="productor" value='&lt;b style="font-size:13px"&gt;Productor de pedidos&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / stomp.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Python. backend/messaging/productor.py. Formatos texto, fijo, JSON y XML&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1480" y="570" width="270" height="120" as="geometry"/></mxCell><mxCell id="db" value='&lt;b style="font-size:13px"&gt;nikkei_roll.db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: SQLite]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Archivo SQLite en backend/db con productos, ingredientes, clientes, pedidos, líneas y pagos&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="830" width="270" height="120" as="geometry"/></mxCell><mxCell id="consumidor" value='&lt;b style="font-size:13px"&gt;Consumidor de cocina&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / stomp.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Python. backend/messaging/consumidor.py. ACK o NACK por mensaje&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="830" width="270" height="120" as="geometry"/></mxCell><mxCell id="servipag" value='&lt;b style="font-size:13px"&gt;Pasarela de pago (Servipag)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Cobro externo del pedido. En la entrega local es un sandbox simulado&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#667586;fontColor=#FFFFFF;strokeColor=#4E5A68;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1070" width="300" height="120" as="geometry"/></mxCell><mxCell id="e0" value='Envía peticiones REST con Bearer&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP / JSON]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value='Login, logout e introspección del token&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP + X-Gateway-Auth-Secret]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value='Reenvía rutas permitidas con identidad y rol&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP + X-Gateway-Secret]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="core"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value='Reenviará consultas agregadas&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP / GraphQL]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;fontColor=#7C3A06;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="gateway" target="graphql"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value='Lee y escribe sus datos&lt;br&gt;&lt;span style="font-size:9px"&gt;[SQLite local]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="core" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value='Lee y escribe productos&lt;br&gt;&lt;span style="font-size:9px"&gt;[Mongoose / TCP 27017]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="graphql" target="mongo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value='Publica el pedido en /queue/pedidos_nikkei&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="productor" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value='Se suscribe y confirma ACK o NACK&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.333;exitY=0.000;exitDx=0;exitDy=0;entryX=0.333;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="consumidor" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value='Entrega un pedido a la vez&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.667;exitY=1.000;exitDx=0;exitDy=0;entryX=0.667;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="broker" target="consumidor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value='Publicará el pedido pagado&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;fontColor=#7C3A06;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="core" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value='Creará la sesión de cobro&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTPS]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;fontColor=#7C3A06;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="core" target="servipag"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>