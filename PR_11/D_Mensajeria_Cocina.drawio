<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="D_Mensajeria_Cocina" name="D_Mensajeria_Cocina"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Flujo · Mensajería de pedidos a cocina · Nikkei Roll" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="170.0" y="0" width="900" height="36" as="geometry"/></mxCell><mxCell id="bound0" value="Nikkei Roll" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BCC8D4;dashed=0;verticalAlign=top;align=center;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="230" width="1200" height="600" as="geometry"/></mxCell><mxCell id="operador" value='&lt;b style="font-size:13px"&gt;Operador de mensajería&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Publica y consume pedidos de cocina desde la terminal&lt;/span&gt;' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#526579;fontColor=#FFFFFF;strokeColor=#3E4F61;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="50" width="260" height="110" as="geometry"/></mxCell><mxCell id="productor" value='&lt;b style="font-size:13px"&gt;Productor de pedidos&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / stomp.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Python. backend/messaging/productor.py. Formatos texto, fijo, JSON y XML&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="270" height="120" as="geometry"/></mxCell><mxCell id="consumidor" value='&lt;b style="font-size:13px"&gt;Consumidor de cocina&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / stomp.py]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Python. backend/messaging/consumidor.py. ACK o NACK por mensaje&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="320" width="270" height="120" as="geometry"/></mxCell><mxCell id="broker" value='&lt;b style="font-size:13px"&gt;ActiveMQ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: ActiveMQ]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Broker STOMP 1.2 en el puerto 61613. Cola persistente /queue/pedidos_nikkei&lt;/span&gt;' style="shape=cylinder3;direction=south;boundedLbl=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="630" width="360" height="120" as="geometry"/></mxCell><mxCell id="e0" value='1. Ejecuta consumidor.py&lt;br&gt;&lt;span style="font-size:9px"&gt;[Terminal]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.667;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="operador" target="consumidor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value='2. SUBSCRIBE con ack client-individual&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="consumidor" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value='3. Ejecuta productor.py con el formato elegido&lt;br&gt;&lt;span style="font-size:9px"&gt;[Terminal]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.333;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="operador" target="productor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value='4. SEND persistente a /queue/pedidos_nikkei&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="productor" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value='5. Entrega un pedido (prefetch 1)&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.333;exitDx=0;exitDy=0;entryX=0.333;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="broker" target="consumidor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value='6. ACK si es válido, NACK si no&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.667;exitY=1.000;exitDx=0;exitDy=0;entryX=1.000;entryY=0.667;entryDx=0;entryDy=0;" edge="1" parent="1" source="consumidor" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>