<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="C3_GraphQL" name="C3_GraphQL"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="930" pageHeight="1310" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="C3 · Agregador GraphQL · Nikkei Roll" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="15.0" y="0" width="900" height="36" as="geometry"/></mxCell><mxCell id="bound0" value="Agregador GraphQL" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BCC8D4;dashed=0;verticalAlign=top;align=center;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="250" y="280" width="430" height="840" as="geometry"/></mxCell><mxCell id="gateway" value='&lt;b style="font-size:13px"&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 8000. Única entrada del navegador. Valida token, aplica roles y reenvía&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="270" height="120" as="geometry"/></mxCell><mxCell id="q_esquema" value='&lt;b style="font-size:13px"&gt;Esquema GraphQL&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Node.js / Apollo Server]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;typeDefs. Producto, ProductoInput, Query y Mutation&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="360" width="270" height="120" as="geometry"/></mxCell><m