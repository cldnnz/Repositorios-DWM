Y=0.000;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="gateway" target="q_esquema"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value='Valida y ejecuta la operación&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q_esquema" target="q_resolvers"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value='Consulta o modifica productos&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q_resolvers" target="q_modelo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value='find, save y findByIdAndUpdate&lt;br&gt;&lt;span style="font-size:9px"&gt;[Mongoose / TCP 27017]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="q_modelo" target="mongo"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>