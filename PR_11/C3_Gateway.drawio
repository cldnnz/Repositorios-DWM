<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="C3_Gateway" name="C3_Gateway"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="1430" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="C3 · Componentes del gateway · Nikkei Roll" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420.0" y="0" width="900" height="36" as="geometry"/></mxCell><mxCell id="bound0" value="API Gateway" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BCC8D4;dashed=0;verticalAlign=top;align=center;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="1050" height="1060" as="geometry"/></mxCell><mxCell id="web" value='&lt;b style="font-size:13px"&gt;Frontend web&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: HTML / CSS / JavaScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;HTML, Tailwind CSS y JavaScript. Se sirve con http.server en el puerto 3000&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="270" height="120" as="geometry"/></mxCell><mxCell id="g_entrada" value='&lt;b style="font-size:13px"&gt;Entrada HTTP y rutas anónimas&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;CORSMiddleware y rutas S01, S02 y S03 sin sesión&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="270" height="120" as="geometry"/></mxCell><mxCell id="g_sesion" value='&lt;b style="font-size:13px"&gt;Proxy de sesión&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;s06_login y s07_logout. Reenvía credenciales y cierre al servicio de autenticación&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="270" height="120" as="geometry"/></mxCell><mxCell id="g_token" value='&lt;b style="font-size:13px"&gt;Verificación de Bearer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verify_bearer_token. Introspección del token en cada ruta protegida&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="270" height="120" as="geometry"/></mxCell><mxCell id="g_roles" value='&lt;b style="font-size:13px"&gt;Control de rol&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;S13 y S16. Responde 403 si el rol no es ADMINISTRADOR o DUENO&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="710" width="270" height="120" as="geometry"/></mxCell><mxCell id="g_reenvio" value='&lt;b style="font-size:13px"&gt;Reenvío privado&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;forward_to_backend. Descarta cabeceras del navegador, agrega X-Gateway-Secret, identidad y X-Correlation-Id&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="920" width="270" height="120" as="geometry"/></mxCell><mxCell id="auth" value='&lt;b style="font-size:13px"&gt;Servicio de autenticación&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 9000. Usuarios semilla con PBKDF2, tokens Bearer opacos de 15 minutos e introspección&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1400" y="500" width="270" height="120" as="geometry"/></mxCell><mxCell id="core" value='&lt;b style="font-size:13px"&gt;Servicios de dominio&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 9001. Inventario, clientes, pedidos y pagos. Solo acepta tráfico con X-Gateway-Secret&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="600" y="1200" width="270" height="120" as="geometry"/></mxCell><mxCell id="e0" value='Envía solicitud&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP / JSON]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.333;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="g_entrada"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value='Login o logout&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_entrada" target="g_sesion"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value='Ruta protegida&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_entrada" target="g_token"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value='Ruta anónima&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.667;exitDx=0;exitDy=0;entryX=0.000;entryY=0.333;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_entrada" target="g_reenvio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value='Reenvía credenciales o cierre de sesión&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP + X-Gateway-Auth-Secret]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_sesion" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value='POST /introspect&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP + X-Gateway-Auth-Secret]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.333;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_token" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value='Token activo en ruta restringida&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_token" target="g_roles"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value='Token activo&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.667;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_token" target="g_reenvio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value='Rol autorizado&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_roles" target="g_reenvio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value='Enruta hacia el servicio privado&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP + X-Gateway-Secret]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_reenvio" target="core"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value='Devuelve la respuesta con X-Correlation-Id&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP / JSON]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.667;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_reenvio" target="web"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>