<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="C3_Servicios_Dominio" name="C3_Servicios_Dominio"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1290" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="C3 · Componentes de los servicios de dominio · Nikkei Roll" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720.0" y="0" width="900" height="36" as="geometry"/></mxCell><mxCell id="bound0" value="Servicios de dominio" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BCC8D4;dashed=0;verticalAlign=top;align=center;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="1760" height="840" as="geometry"/></mxCell><mxCell id="gateway" value='&lt;b style="font-size:13px"&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 8000. Única entrada del navegador. Valida token, aplica roles y reenvía&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="50" width="270" height="120" as="geometry"/></mxCell><mxCell id="c_guardia" value='&lt;b style="font-size:13px"&gt;Guardia del gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;verify_gateway. Compara X-Gateway-Secret en tiempo constante&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="270" height="120" as="geometry"/></mxCell><mxCell id="c_cobertura" value='&lt;b style="font-size:13px"&gt;Cobertura de reparto&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;clients. S03. Verifica el radio de 3 km en Maipú&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="550" width="270" height="120" as="geometry"/></mxCell><mxCell id="c_catalogo" value='&lt;b style="font-size:13px"&gt;Catálogo e ingredientes&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;inventory. S01, S02 y S13. Catálogo público, Arma tu Roll y disponibilidad&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="550" width="270" height="120" as="geometry"/></mxCell><mxCell id="c_pedidos" value='&lt;b style="font-size:13px"&gt;Pedidos&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;orders. S09, S11, S12 y S16. Recalcula el total, descuenta stock, Anti-BOLA, anulación y reporte&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="550" width="270" height="120" as="geometry"/></mxCell><mxCell id="c_pagos" value='&lt;b style="font-size:13px"&gt;Pagos&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;payments. S10. Verifica propiedad del pedido y entrega el monto oficial a cobrar&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1510" y="550" width="270" height="120" as="geometry"/></mxCell><mxCell id="c_datos" value='&lt;b style="font-size:13px"&gt;Acceso a datos&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Componente: Python / sqlite3]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;get_db e init_db. Crea el esquema y los datos semilla&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="830" width="270" height="120" as="geometry"/></mxCell><mxCell id="db" value='&lt;b style="font-size:13px"&gt;nikkei_roll.db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: SQLite]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Archivo SQLite en backend/db con productos, ingredientes, clientes, pedidos, líneas y pagos&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="1090" width="270" height="120" as="geometry"/></mxCell><mxCell id="servipag" value='&lt;b style="font-size:13px"&gt;Pasarela de pago (Servipag)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Cobro externo del pedido. En la entrega local es un sandbox simulado&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#667586;fontColor=#FFFFFF;strokeColor=#4E5A68;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2000" y="550" width="270" height="120" as="geometry"/></mxCell><mxCell id="broker" value='&lt;b style="font-size:13px"&gt;ActiveMQ&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: ActiveMQ]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Broker STOMP 1.2 en el puerto 61613. Cola persistente /queue/pedidos_nikkei&lt;/span&gt;' style="shape=cylinder3;direction=south;boundedLbl=1;size=14;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2000" y="1030" width="270" height="120" as="geometry"/></mxCell><mxCell id="e0" value='Reenvía solicitud con secreto e identidad&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP + X-Gateway-Secret]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="c_guardia"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value='Solicitud autorizada&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.200;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_guardia" target="c_cobertura"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value='Solicitud autorizada&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.400;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_guardia" target="c_catalogo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value='Solicitud autorizada&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.600;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_guardia" target="c_pedidos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value='Solicitud autorizada&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.800;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_guardia" target="c_pagos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value='Valida disponibilidad, precios y descuenta stock&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_pedidos" target="c_catalogo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value='Consulta propietario e importe oficial&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_pagos" target="c_pedidos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value='Lee y actualiza productos&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.333;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_catalogo" target="c_datos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value='Lee y escribe pedidos y líneas&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.333;exitY=1.000;exitDx=0;exitDy=0;entryX=0.667;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_pedidos" target="c_datos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value='Lee pedidos&lt;br&gt;&lt;span style="font-size:9px"&gt;[Llamada interna]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=1.000;entryY=0.500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_pagos" target="c_datos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value='Lee y escribe&lt;br&gt;&lt;span style="font-size:9px"&gt;[SQLite local]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_datos" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value='Publicará el pedido pagado&lt;br&gt;&lt;span style="font-size:9px"&gt;[STOMP 1.2]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;fontColor=#7C3A06;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.667;exitY=1.000;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c_pedidos" target="broker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value='Creará la sesión de cobro&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTPS]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B45309;fontColor=#7C3A06;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="c_pagos" target="servipag"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>