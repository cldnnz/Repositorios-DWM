<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="D_Consulta_Protegida" name="D_Consulta_Protegida"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="Flujo · Consulta protegida de un pedido · Nikkei Roll" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20.0" y="0" width="900" height="36" as="geometry"/></mxCell><mxCell id="bound0" value="Nikkei Roll" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#BCC8D4;dashed=0;verticalAlign=top;align=center;fontSize=18;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="220" width="900" height="970" as="geometry"/></mxCell><mxCell id="cliente" value='&lt;b style="font-size:13px"&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Arma su carrito, paga y consulta sus propios pedidos&lt;/span&gt;' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#526579;fontColor=#FFFFFF;strokeColor=#3E4F61;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="50" width="270" height="110" as="geometry"/></mxCell><mxCell id="web" value='&lt;b style="font-size:13px"&gt;Frontend web&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: HTML / CSS / JavaScript]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;HTML, Tailwind CSS y JavaScript. Se sirve con http.server en el puerto 3000&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="260" width="270" height="120" as="geometry"/></mxCell><mxCell id="gateway" value='&lt;b style="font-size:13px"&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 8000. Única entrada del navegador. Valida token, aplica roles y reenvía&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="270" height="120" as="geometry"/></mxCell><mxCell id="auth" value='&lt;b style="font-size:13px"&gt;Servicio de autenticación&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 9000. Usuarios semilla con PBKDF2, tokens Bearer opacos de 15 minutos e introspección&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="270" height="120" as="geometry"/></mxCell><mxCell id="core" value='&lt;b style="font-size:13px"&gt;Servicios de dominio&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: Python / FastAPI]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;FastAPI 9001. Inventario, clientes, pedidos y pagos. Solo acepta tráfico con X-Gateway-Secret&lt;/span&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="750" width="460" height="120" as="geometry"/></mxCell><mxCell id="db" value='&lt;b style="font-size:13px"&gt;nikkei_roll.db&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Contenedor: SQLite]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Archivo SQLite en backend/db con productos, ingredientes, clientes, pedidos, líneas y pagos&lt;/span&gt;' style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#EDF2F7;fontColor=#172B40;strokeColor=#9FB1C4;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1020" width="460" height="120" as="geometry"/></mxCell><mxCell id="e0" value='1. Abre el seguimiento de su pedido&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cliente" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value='2. GET /api/v1/orders/{id} con Bearer&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP / JSON]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value='3. Introspecciona el token&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP + X-Gateway-Auth-Secret]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value='4. Reenvía identidad y rol&lt;br&gt;&lt;span style="font-size:9px"&gt;[HTTP + X-Gateway-Secret]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="gateway" target="core"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value='5. Lee el pedido y compara el dueño (Anti-BOLA)&lt;br&gt;&lt;span style="font-size:9px"&gt;[SQLite local]&lt;/span&gt;' style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7C8F;fontColor=#334155;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="core" target="db"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>