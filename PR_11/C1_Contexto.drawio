<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="C1_Contexto" name="C1_Contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="890" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titulo" value="C1 · Contexto de Nikkei Roll · Nikkei Roll" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="350.0" y="0" width="900" height="36" as="geometry"/></mxCell><mxCell id="cliente" value='&lt;b style="font-size:13px"&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Arma su carrito, paga y consulta sus propios pedidos&lt;/span&gt;' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#526579;fontColor=#FFFFFF;strokeColor=#3E4F61;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="230" height="110" as="geometry"/></mxCell><mxCell id="admin" value='&lt;b style="font-size:13px"&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Gestiona productos, disponibilidad y pedidos (puede anular)&lt;/span&gt;' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#526579;fontColor=#FFFFFF;strokeColor=#3E4F61;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="230" height="110" as="geometry"/></mxCell><mxCell id="owner" value='&lt;b style="font-size:13px"&gt;Dueño&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Consulta el reporte de ventas y la disponibilidad del catálogo&lt;/span&gt;' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#526579;fontColor=#FFFFFF;strokeColor=#3E4F61;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="70" width="230" height="110" as="geometry"/></mxCell><mxCell id="cashier" value='&lt;b style="font-size:13px"&gt;Cajero Virtual&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Gestiona comprobantes y consulta pedidos de la caja web&lt;/span&gt;' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#526579;fontColor=#FFFFFF;strokeColor=#3E4F61;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="70" width="230" height="110" as="geometry"/></mxCell><mxCell id="dispatch" value='&lt;b style="font-size:13px"&gt;Encargado de Despacho&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Consulta órdenes pagadas y registra el avance de entrega&lt;/span&gt;' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#526579;fontColor=#FFFFFF;strokeColor=#3E4F61;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="70" width="230" height="110" as="geometry"/></mxCell><mxCell id="operador" value='&lt;b style="font-size:13px"&gt;Operador de mensajería&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Publica y consume pedidos de cocina desde la terminal&lt;/span&gt;' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#526579;fontColor=#FFFFFF;strokeColor=#3E4F61;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="70" width="230" height="110" as="geometry"/></mxCell><mxCell id="sistema" value='&lt;b style="font-size:13px"&gt;Nikkei Roll&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;[Sistema]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;Venta online de sushi fusión peruano-japonés con carrito, pagos, despacho y reportes&lt;/s